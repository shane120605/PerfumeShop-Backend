APP_NAME="Perfume Shop API"
APP_ENV=local

APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------- MySQL ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perfume_shop
DB_USERNAME=perfume_user

DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- API tokens ----------
# Token lifetime in minutes (10080 = 7 days)
SANCTUM_TOKEN_EXPIRATION=10080

ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Optional: demo customers + sample orders ----------
# Used only by:  php artisan db:seed --class=DemoDataSeeder
# Leave empty to get a random password printed in the terminal.
DEMO_PASSWORD=
